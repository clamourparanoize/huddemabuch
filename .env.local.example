# Kopiere diese Datei nach ".env.local" und trage deine echten Werte ein.
# ".env.local" wird nicht eingecheckt (siehe .gitignore).

# Supabase-Projekt (kann dasselbe Konto sein wie beim Chronik-Projekt,
# aber ein EIGENES Projekt/eigene Tabellen - nicht dieselbe Datenbank
# wiederverwenden). Beide Werte findest du im Supabase-Dashboard unter
# Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" Key - NIEMALS im Client verwenden, niemals mit
# NEXT_PUBLIC_ Prefix versehen. Wird für den Admin-Bereich benötigt
# (Freischalten/Bearbeiten/Ablehnen umgeht die RLS-Policies bewusst,
# siehe src/lib/supabase/admin.ts). Nur in Server-only-Code lesen.
SUPABASE_SERVICE_ROLE_KEY=

# Zugangsdaten für den Admin-Bereich (/admin) - einfacher HTTP-Basic-Auth-
# Schutz, kein volles Login-System nötig, da es nur einen Prüfer gibt.
# Enthält das Passwort ein "#" oder andere Sonderzeichen, den Wert in
# Anführungszeichen setzen (z. B. PASSWORD="huttenh0im#26").
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# Cloudflare Turnstile (Bot-Schutz für das öffentliche Einreichen-Formular).
# Optional - ohne gesetzten Key läuft das Formular ohne Bot-Schutz.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Wöchentliche Zusammenfassung der ungeprüften Einträge per Mail
# (Vercel Cron, jeden Montag ca. 7-8 Uhr, siehe vercel.json).
# Resend: https://resend.com -> API Keys. Ohne diese Werte wird keine Mail
# verschickt. CRON_SECRET frei wählen (lange Zufallszeichenfolge) - Vercel
# sendet ihn beim Cron-Aufruf automatisch mit.
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
CRON_SECRET=
# Optional: eigener Absender (Domain muss bei Resend verifiziert sein) und
# Basis-URL für den Link in der Mail.
# MAIL_FROM="Huddemabuch <huddemabuch@deine-domain.de>"
# SITE_URL=https://mundart.huddene.de
